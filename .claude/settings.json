{
  "permissions": {
    "allow": [
      "Bash(python3 -m bench.run:*)",
      "Bash(python3 -m bench.diagnose:*)",
      "Bash(python3 -m bench.guard:*)",
      "Bash(python3 -m bench.contribute --dry-run:*)",
      "Bash(py -m bench.run:*)",
      "Bash(py -m bench.diagnose:*)",
      "Bash(py -m bench.guard:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(python play.py:*)",
      "Bash(python3 play.py:*)",
      "Bash(py play.py:*)",
      "Bash(uv run play.py:*)",
      "Bash(python starter_agent.py:*)",
      "Bash(python3 starter_agent.py:*)",
      "Bash(py starter_agent.py:*)",
      "Bash(uv run starter_agent.py:*)",
      "Bash(python starter_broker.py:*)",
      "Bash(python3 starter_broker.py:*)",
      "Bash(py starter_broker.py:*)",
      "Bash(uv run starter_broker.py:*)",
      "Bash(python smart_agent.py:*)",
      "Bash(python3 smart_agent.py:*)",
      "Bash(py smart_agent.py:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/solo_mi_carpeta.py\""
          }
        ]
      }
    ]
  }
}
